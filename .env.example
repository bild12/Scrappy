# ============================================================
# Collective Mining — Executive Dashboard
# .env.example  →  Copy as .env and fill your values
# NEVER commit .env to git (it's in .gitignore)
# ============================================================

# --- Microsoft Teams Incoming Webhook ---
# In Teams: Open channel → ... → Connectors → Incoming Webhook → Configure → Copy URL
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXXX/IncomingWebhook/XXXX

# --- Email via Resend API ---
# Sign up at resend.com — free tier: 3,000 emails/month, 100/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=ceo@collectivemining.com,vp@collectivemining.com

# --- Alert Thresholds (override defaults in config.py) ---
PRICE_ALERT_THRESHOLD=3.0       # % change to trigger price alert
VOLUME_ALERT_MULTIPLIER=2.0     # x times 20d avg volume to trigger
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
